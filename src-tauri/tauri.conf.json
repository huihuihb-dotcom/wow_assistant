{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wow_assistant",
  "version": "0.1.0",
  "identifier": "com.huihu.wow_assistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WoW 智能硬件助手 (RP2040 硬件驱动版)",
        "width": 940,
        "height": 720,
        "minWidth": 800,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../models/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
